		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@fontsource/inter": "^5.3.0",
		"@fontsource/playfair-display": "^5.3.0",
		"@prisma/client": "^6.4.1",
		"bcryptjs": "^3.0.3",
		"clsx": "^2.1.1",
		"lucide-svelte": "^1.0.1",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.5"
